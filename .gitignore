# ============================================================
#  AKIM — .gitignore
#  Tierra Byte SA.
# ============================================================

# --- 🔴 SEGURIDAD CRÍTICA: Credenciales y Configuración ---
/includes/config/
/includes/app.php
/api/config.php
.env
.scripts

# --- 🔴 AFIP / ARCA: Claves privadas y certificados (NUNCA al repo) ---
arca/*/key/
arca/*/key/**
*.pem
*.p12
*.pfx
*.crt
*.cer
*.key
privada

# --- 🔴 AFIP / ARCA: Tokens de sesión WSAA (son runtime, expiran) ---
arca/*/token/
arca/*/token/**
TA.xml
TRA.xml

# --- 🟡 AFIP / ARCA: Temporales de debug XML (no son código) ---
arca/*/tmp/
arca/*/tmp/**

# --- 🟡 Imágenes y archivos de tenant (datos de cliente, no código) ---
/public/repositorio/
/public/tmp/
/public/imagenes/usuarios/

# --- 🟡 Scripts de backup expuestos en raíz ---
/backup_download.php
/backup_list.php

# --- 🟡 Build y generados ---
/build/

# --- ⚙️  Sistema y temporales ---
.DS_Store
Thumbs.db
*.log
*.tmp

# --- 📋 Registros y Logs ---
Logs/
logs/

# --- 📦 Dependencias (se instalan con Composer, no se versionan) ---
/vendor/
/node_modules/

# --- 🛠️  IDEs ---
.vscode/
.idea/
*.swp
*.swo

# --- 🤖 Herramientas de IA ---
.claude/
.agents/
